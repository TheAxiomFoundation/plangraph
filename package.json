{
  "name": "plangraph",
  "version": "0.1.0",
  "description": "Planning as a computation graph: work items with dependencies, seats with hire dates and fallbacks, revenue keyed to unlocks, scenarios, and a harness that says where the plan does not make sense.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAxiomFoundation/plangraph"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "plangraph": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bunx vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bun src/cli.ts check examples/studio.yaml",
    "watch": "bun src/cli.ts watch examples/studio.yaml",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build && bun run test && bun run check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "keywords": [
    "planning",
    "project-management",
    "scheduling",
    "resource-leveling",
    "roadmap",
    "dependency-graph",
    "scenario",
    "harness"
  ]
}
